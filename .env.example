# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=
# Postgres in production (Render sets this). Locally SQLite is used when empty.
DATABASE_URL=
# Long random string; signs nothing but protects /api/cron/tick
CRON_SECRET=change-me
# Public URL used in invite links printed to the log
PUBLIC_URL=http://localhost:8000
